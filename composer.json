{
    "name": "testmonitor/laravel-vue-i18n-generator",
    "description": "This package compiles your Laravel translation files into a Vue i18n compatible JSON file.",
    "keywords": [
        "testmonitor",
        "laravel",
        "vue-i18n",
        "laravel-vue-i18n-generator"
    ],
    "homepage": "https://github.com/testmonitor/laravel-vue-i18n-generator",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Thijs Kok",
            "email": "thijs.kok@cerios.com",
            "homepage": "https://www.testmonitor.com/",
            "role": "Lead Developer"
        },
        {
            "name": "Stephan Grootveld",
            "email": "stephan.grootveld@cerios.com",
            "homepage": "https://www.testmonitor.com/",
            "role": "Developer"
        },
        {
            "name": "Frank Keulen",
            "email": "frank.keulen@cerios.com",
            "homepage": "https://www.testmonitor.com/",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.11",
        "laravel/pint": "^1.30",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^13.0",
        "rector/rector": "^2.6",
        "squizlabs/php_codesniffer": "^3.5.2"
    },
    "autoload": {
        "psr-4": {
            "TestMonitor\\VueI18nGenerator\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TestMonitor\\VueI18nGenerator\\Tests\\": "tests"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "style": "vendor/bin/pint --test",
        "sniff": "vendor/bin/phpcs",
        "refactor": "vendor/bin/rector process --dry-run",
        "test": "vendor/bin/phpunit --no-coverage",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
        "check": [
            "@style",
            "@sniff",
            "@analyse",
            "@refactor",
            "@test"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "TestMonitor\\VueI18nGenerator\\VueI18nGeneratorServiceProvider"
            ]
        }
    },
    "prefer-stable": true
}
